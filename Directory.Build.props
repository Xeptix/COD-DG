<Project>

  <!-- Shared by every project, so the window, the commands and the console stub all say the same version. -->
  <PropertyGroup>
    <Version>1.1.1</Version>
    <Product>COD Downgrader</Product>
    <Description>Download any build of a Call of Duty you own on Steam, into your installed game or into a folder of its own.</Description>
    <Authors>Xep</Authors>
    <Company>Xeptix</Company>
    <Copyright>Copyright (c) 2026 Xeptix</Copyright>
    <RepositoryUrl>https://github.com/Xeptix/COD-DG</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- A release carries no symbol files, the libraries' included. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
