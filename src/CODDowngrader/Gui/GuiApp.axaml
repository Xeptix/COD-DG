<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CODDowngrader.Gui.ViewModels"
             xmlns:views="using:CODDowngrader.Gui.Views"
             x:Class="CODDowngrader.Gui.GuiApp"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#FFF7F7F8" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#FFEDEDEF" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="StrokeBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FFC42B1C" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FF8A5300" />
          <SolidColorBrush x:Key="OkBrush" Color="#FF0F7B0F" />
          <SolidColorBrush x:Key="BadgeBrush" Color="#FFF3E2B8" />
          <SolidColorBrush x:Key="BadgeTextBrush" Color="#FF5C4200" />
          <SolidColorBrush x:Key="LogBrush" Color="#FFF0F0F2" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#FF151517" />
          <SolidColorBrush x:Key="CardBrush" Color="#FF26262A" />
          <SolidColorBrush x:Key="StrokeBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF99A4" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FFFCE100" />
          <SolidColorBrush x:Key="OkBrush" Color="#FF6CCB5F" />
          <SolidColorBrush x:Key="BadgeBrush" Color="#FF4A3A12" />
          <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFF7DFA0" />
          <SolidColorBrush x:Key="LogBrush" Color="#FF121214" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!--
      The app's own accent, the same in both themes. Left alone, Fluent takes Windows' accent colour, and a grey one there made the
      progress bar and the main buttons a grey among greys in the dark theme.
    -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF0078D4" />
        <ColorPaletteResources x:Key="Dark" Accent="#FF0078D4" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="12,8,0,4" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.page">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    </Style>
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="Margin" Value="0,14" />
    </Style>
    <Style Selector="Border.actionbar">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    </Style>
    <Style Selector="Border.log">
      <Setter Property="Background" Value="{DynamicResource LogBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="ListBox.list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:GamePageViewModel">
      <views:GamePage />
    </DataTemplate>
    <DataTemplate DataType="vm:ActionPageViewModel">
      <views:ActionPage />
    </DataTemplate>
    <DataTemplate DataType="vm:RunPageViewModel">
      <views:RunPage />
    </DataTemplate>
    <DataTemplate DataType="vm:HelperPageViewModel">
      <views:HelperPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SetupPageViewModel">
      <views:SetupPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel">
      <views:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SharePageViewModel">
      <views:SharePage />
    </DataTemplate>
    <DataTemplate DataType="vm:BuildsPageViewModel">
      <views:BuildsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:OpenBuildPageViewModel">
      <views:OpenBuildPage />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
