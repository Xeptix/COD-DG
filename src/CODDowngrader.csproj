<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CODDowngrader</AssemblyName>
    <RootNamespace>CODDowngrader</RootNamespace>
    <Version>1.0.1</Version>
    <Product>COD Downgrader</Product>
    <Description>Download any build of a Call of Duty you own on Steam, into your installed game or into a folder of its own.</Description>
    <Authors>Xep</Authors>
    <Company>Xeptix</Company>
    <Copyright>Copyright (c) 2026 Xeptix</Copyright>
    <RepositoryUrl>https://github.com/Xeptix/COD-DG</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 (or linux-x64): one self-contained executable. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\manifests.txt" LogicalName="manifests.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CODDowngrader.Tests" />
  </ItemGroup>

</Project>
